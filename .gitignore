# ==================== Credenciales y datos privados ====================
# NUNCA subir estos archivos. Usa las plantillas *.example.* como guía.

# Firebase (project_id + API keys de cliente)
android/app/google-services.json
lib/firebase_options.dart

# Caché local del CLI de Firebase: la crea cada `firebase deploy` y solo guarda
# el estado de la última publicación en este equipo. No es configuración del
# proyecto y no debe versionarse.
.firebase/

# firebase.json y .firebaserc SÍ se versionan: son la configuración de
# despliegue del proyecto (reglas de Firestore y hosting). No contienen claves
# privadas; el identificador del proyecto y las claves de cliente de Firebase
# son públicos por diseño y viajan dentro del paquete web desplegado. La
# protección real está en firestore.rules y en el backend.
#
# OJO: si se vuelve a ejecutar `flutterfire configure`, revisar que firebase.json
# conserve las claves "firestore" y "hosting" después de la regeneración.

# Firma de Android (keystores + passwords)
android/local.properties
android/key.properties
*.jks
*.keystore
*.p12

