# =============================================================================
# SIGVACH — Plantilla de variables de entorno
#
# Uso: copiar este archivo como `.env`, completar los valores reales y mantener
# el `.env` fuera del repositorio. El archivo `.gitignore` ya excluye `.env` y
# `.env.*`, y conserva únicamente esta plantilla (`!.env.example`).
#
# Ningún valor de este archivo debe contener credenciales reales.
# =============================================================================

# ----------------------------- Backend de la API -----------------------------

# Puerto de escucha del servidor en desarrollo (el lanzador SIGVACH.bat usa 8011)
PORT=8011

# Orígenes autorizados para las peticiones del navegador, separados por comas
ALLOWED_ORIGINS=http://localhost:8080,https://TU-PROYECTO.web.app

# Nivel del registro de la aplicación (el que escribe, entre otras cosas, la
# línea de cada petición: método, ruta, código y duración). Se admiten los
# niveles del módulo `logging` de Python. Con DEBUG la línea no cambia: solo se
# añaden los mensajes de diagnóstico de los componentes que los tengan, entre
# ellos el acierto o el fallo de la memoria intermedia de lecturas.
NIVEL_REGISTRO=INFO

# Ventana de la memoria intermedia de las consultas de lecturas, en segundos.
# Es la memoria que sostiene el RNF-01: el panel repite la misma consulta cada
# pocos segundos y, sin ella, cada repetición vuelve a leer y a serializar todos
# los documentos de la colección. Diez segundos por omisión, muy por debajo de
# los cinco minutos y medio con que el módulo de adquisición publica lecturas
# nuevas. Con 0 la memoria queda desactivada y toda consulta va a la base: es el
# valor con el que se mide el «antes» de optimizar.
SEGUNDOS_CACHE_LECTURAS=10

# Clave que autentica al módulo de adquisición (ESP32) al publicar lecturas.
# Debe ser una cadena aleatoria larga y distinta de cualquier credencial de
# usuario. Se envía en la cabecera X-Device-Key y puede rotarse sin afectar a
# los usuarios del sistema.
DEVICE_API_KEY=cambiar-por-una-cadena-aleatoria-larga

# Identificador del proyecto de Firebase
FIREBASE_PROJECT_ID=

# Nombres de los tres roles. Se leen de la configuración para que el alcance de
# roles no obligue a modificar el código de autorización. Los valores
# predeterminados ya coinciden con los del código y del backend:
#   administrador → administra módulos, rangos y cuentas;
#   operador      → registra lecturas y consulta la información del cultivo
#                   (es el rol asignado por defecto);
#   invitado      → solo consulta el panel, el historial y las alertas.
ROL_ADMINISTRADOR=administrador
ROL_OPERADOR=operador
ROL_INVITADO=invitado

# Credenciales de la cuenta de servicio, necesarias para que el backend acceda
# a Cloud Firestore. Usar UNA de las dos alternativas:
#   a) pegar el JSON completo de la cuenta de servicio en una sola línea
#   b) indicar la ruta al archivo descargado (nunca dentro del repositorio)
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# --------------------- Aplicación Flutter (web y móvil) ----------------------

# Dirección del backend que consume la aplicación. Se define en tiempo de
# compilación, no en el código, para que el mismo código apunte al servicio
# local o al desplegado:
#   flutter run           --dart-define=API_BASE_URL=http://10.0.2.2:8011  (emulador Android)
#   flutter run -d web-server --dart-define=API_BASE_URL=http://127.0.0.1:8011
#   flutter build web     --dart-define=API_BASE_URL=https://TU-API.onrender.com
# Si no se define, la aplicación usa una dirección local según el dispositivo.
API_BASE_URL=

# Alternativa a lib/firebase_options.dart cuando se compila desde integración
# continua o desde una máquina distinta:
#   flutter build web --dart-define=FIREBASE_API_KEY=... (y el resto)
# Las claves del cliente de Firebase son públicas por diseño: su protección no
# depende de ocultarlas, sino de las reglas de seguridad y del backend.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ------------------------- Documentación del proyecto ------------------------

# Plantilla oficial de la monografía, usada por scripts/md_a_docx.py
PLANTILLA_MONOGRAFIA=Plantilla Monografia (Diplomado).docx
